{
  "name": "rawaqa-backend",
  "version": "2.0.0",
  "description": "RAWAQA 2.0 - Production-grade e-commerce backend",
  "main": "dist/server.js",
  "scripts": {
    "dev": "nodemon --exec ts-node src/server.ts",
    "build": "tsc",
    "start": "node --max-old-space-size=400 dist/server.js",
    "seed": "ts-node prisma/seed.ts",
    "db:generate": "node node_modules/prisma/build/index.js generate",
    "db:migrate": "node node_modules/prisma/build/index.js migrate dev",
    "db:migrate:deploy": "node node_modules/prisma/build/index.js migrate deploy",
    "db:validate": "node node_modules/prisma/build/index.js validate",
    "migrate:mongodb:dry-run": "ts-node src/scripts/migrate-mongodb-to-postgres.ts --dry-run",
    "migrate:mongodb": "ts-node src/scripts/migrate-mongodb-to-postgres.ts",
    "worker": "ts-node src/workers/outbox.worker.ts",
    "reconcile": "ts-node src/workers/inventory-reconciliation.worker.ts",
    "test": "jest --runInBand",
    "test:coverage": "jest --runInBand --coverage",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "keywords": [
    "ecommerce",
    "express",
    "typescript",
    "mongodb",
    "odoo"
  ],
  "author": "RAWAQA",
  "license": "UNLICENSED",
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@sentry/node": "^8.55.2",
    "@types/multer": "^2.2.0",
    "@vonage/server-sdk": "^3.30.0",
    "axios": "^1.6.2",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.11.0",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "exceljs": "^4.4.0",
    "express": "^4.18.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.0.3",
    "morgan": "^1.10.0",
    "multer": "^2.3.0",
    "node-cron": "^3.0.3",
    "nodemailer": "^9.1.1",
    "pg": "^8.23.0",
    "uuid": "^9.0.1",
    "winston": "^3.11.0",
    "winston-daily-rotate-file": "^4.7.1",
    "xss": "^1.0.15",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.10.6",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.23.1",
    "@types/uuid": "^9.0.7",
    "nodemon": "^3.0.2",
    "prisma": "7.10.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "allowScripts": {
    "bcrypt@5.1.1": true,
    "prisma@7.10.0": true,
    "@prisma/engines@7.10.0": true
  }
}
