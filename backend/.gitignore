# Dependencies
node_modules/
package-lock.json
yarn.lock
pnpm-lock.yaml

# Build output
dist/
build/
*.tsbuildinfo

# Environment files
.env
.env.local
.env.*.local
.env.render

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# OS files
.DS_Store
Thumbs.db
desktop.ini

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Testing
coverage/
.nyc_output/

# Temporary files
tmp/
temp/
*.tmp

# Uploads
uploads/
!uploads/.gitkeep

# Database dumps
*.dump
# Ignore standalone sql dump files but NOT Prisma migration files
*.sql
!prisma/migrations/**/*.sql

# Prisma generated client (regenerate with: npm run db:generate)
src/generated/
prisma/generated/

# Pre-migration backup files (local only)
mongo-backup-*.json

# Cloudflare Workers (local dev secrets + build output — never commit)
.dev.vars
.dev.vars.*
dist-worker/
.wrangler/
cf-dev*.log
cf-probe*.log
